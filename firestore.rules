rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function meuUid() { return request.auth.uid; }
    function refLista(id) {
      return /databases/$(database)/documents/sharedLists/$(id);
    }
    function refMembro(id, uid) {
      return /databases/$(database)/documents/sharedLists/$(id)/members/$(uid);
    }
    function refConvite(token) {
      return /databases/$(database)/documents/invites/$(token);
    }
    function dono(id) {
      return logado() && get(refLista(id)).data.ownerId == meuUid();
    }
    function participante(id) {
      return logado() && exists(refMembro(id, meuUid()));
    }
    function comprasValidas(dados) {
      return dados.versao == 1
        && dados.compras is map
        && dados.compras.size() <= 300;
    }

    // Lista de compras única para várias contas autorizadas.
    match /sharedLists/{listId} {
      allow get: if logado() && (
        resource.data.ownerId == meuUid() || participante(listId)
      );
      allow list: if false;
      allow create: if logado()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'versao', 'compras', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.ownerId == meuUid()
        && comprasValidas(request.resource.data)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if logado()
        && (resource.data.ownerId == meuUid() || participante(listId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['compras', 'atualizadoEm'])
        && request.resource.data.atualizadoEm == request.time
        && comprasValidas(request.resource.data);
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if logado() && (dono(listId) || memberUid == meuUid());
        allow list: if dono(listId);
        allow create: if logado()
          && memberUid == meuUid()
          && request.resource.data.keys().hasOnly(['inviteId','email','joinedAt'])
          && request.resource.data.inviteId is string
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.joinedAt == request.time
          // O convite só pode ser consumido junto da criação da participação.
          && get(refConvite(request.resource.data.inviteId)).data.usedBy == null
          && get(refConvite(request.resource.data.inviteId)).data.listId == listId
          && get(refConvite(request.resource.data.inviteId)).data.expiresAt > request.time
          && getAfter(refConvite(request.resource.data.inviteId)).data.usedBy == meuUid();
        allow update: if false;
        allow delete: if dono(listId);
      }
    }

    // Token aleatório de 256 bits no URL. Não existe consulta pública aos convites.
    match /invites/{token} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado()
        && token.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly([
          'listId','createdBy','createdAt','expiresAt','usedBy','usedAt'
        ])
        && request.resource.data.createdBy == meuUid()
        && dono(request.resource.data.listId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h')
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;
      allow update: if logado()
        && resource.data.usedBy == null
        && resource.data.usedAt == null
        && resource.data.expiresAt > request.time
        && resource.data.createdBy != meuUid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == meuUid()
        && request.resource.data.usedAt == request.time
        // O mesmo lote/transaction DEVE adicionar este usuário como participante.
        && !exists(refMembro(resource.data.listId, meuUid()))
        && getAfter(refMembro(resource.data.listId, meuUid())).data.inviteId == token;
      allow delete: if false;
    }

    // Cada conta escolhe qual lista compartilhada deseja abrir.
    match /users/{uid}/settings/{setting} {
      allow get: if logado() && meuUid() == uid && setting == 'current';
      allow list: if false;
      allow create, update: if logado()
        && meuUid() == uid
        && setting == 'current'
        && request.resource.data.keys().hasOnly(['listId'])
        && request.resource.data.listId is string
        && request.resource.data.listId.size() < 150;
      allow delete: if false;
    }
  }
}
